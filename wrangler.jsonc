{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yahoo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "3fb4c6a307344d5a8d9deb2a45151830"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yahoo_mcp",
      "database_id": "7224303c-89c4-4c8e-a5a4-592970b0066b",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "TOKEN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "REGISTER_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
